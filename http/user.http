###
### Get me failure example: missing token
GET {{baseUrl}}/api/v1/users/me
Accept: application/json

> {%
client.test("Missing token status is 401", function() {
  client.assert(response.status === 401, "Expected 401 Unauthorized");
});
%}

###
### Get me failure example: invalid token
GET {{baseUrl}}/api/v1/users/me
Authorization: Bearer invalid.token.value
Accept: application/json

> {%
client.test("Invalid token status is 401", function() {
  client.assert(response.status === 401, "Expected 401 Unauthorized");
});
%}
